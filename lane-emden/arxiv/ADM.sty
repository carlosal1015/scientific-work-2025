EXAMPLES OF DIFFERENTIAL EQUATIONS RESOLVED BY ADM





 The general operator equation is written as
\begin{equation}\label{eq:generaloperator}
	Lu+Ru+Nu=g.
\end{equation}
Where the operators represent

	\begin{itemize}
		\setlength\itemsep{0em}
		\item $L$: Highest order derivative.
		
		\item $R$: Lower order derivatives.
		
		\item $N$: Nonlinear terms.
		
		\item $g$: Source term.
	\end{itemize}

Applying $L^{-1}$ to~\eqref{eq:generaloperator}, we obtain
\begin{equation*}
	u=
	\Phi+
	L^{-1}g-
	L^{-1}Ru-
	L^{-1}Nu,
\end{equation*}
where $\Phi$ is chosen so that the solution $u$ satisfies the initial conditions.
\begin{definition}[Adomian polynomials $A_{n}$ and $L^{-1}$ for Lane-Emden]
	\begin{align*}
		\forall n\in\mathbb{N}\cup\left\{0\right\}:
		A_{n}  & \coloneqq
		\frac{1}{n!}
		\diff*[n]{
			\left[
			N\left(
			\sum_{i=0}^{\infty}
			\lambda^{i}
			u_{i}
			\right)
			\right]_{\lambda=0}}{\lambda}. \\
		L^{-1} & \coloneqq
		\int_{0}^{\xi}
		\xi^{-2}
		\int_{0}^{\xi}
		\xi^{2}\left(\cdot\right)
		\dl \xi
		\dl \xi.
	\end{align*}
\end{definition}
\vspace*{-.5\baselineskip}\setlength\belowdisplayshortskip{0pt}
Decomposing $u=\sum\limits_{n=0}^{\infty}u_{n}$,
the recursive scheme is
\begin{equation}\label{eq:adm_system}
	\boxed{
		\left\{
		\begin{aligned}
			\forall n\in\mathbb{N}\cup\left\{0\right\}:
			u_{n+1} & =
			-L^{-1}Ru_{n}-L^{-1}A_{n}. \\
			u_{0}   & =
			\phi+L^{-1}g.
		\end{aligned}
		\right.
		}
\end{equation}


